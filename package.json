{
  "name": "perf-prove-it",
  "version": "0.1.1",
  "type": "module",
  "description": "Static performance audit for TypeScript and JavaScript. Parses with oxc, lowers files to facts, ranks candidates, and ships the agent skill.",
  "bin": {
    "perf-prove-it": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-transform-types --test test/*.test.mts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115",
    "oxc-parser": "0.150.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.24.0",
    "@types/node": "^24.0.0",
    "acorn": "^8.11.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "author": "Priyansh Shah",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priyansh4444/perf-prove-it.git"
  },
  "homepage": "https://github.com/Priyansh4444/perf-prove-it#readme",
  "bugs": {
    "url": "https://github.com/Priyansh4444/perf-prove-it/issues"
  },
  "keywords": [
    "performance",
    "v8",
    "bytecode",
    "oxc",
    "effect",
    "typescript",
    "static-analysis",
    "code-review"
  ],
  "publishConfig": {
    "access": "public"
  }
}
